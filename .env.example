# Firebase Web App config — copy this file to ".env.local" and fill in your values.
# Find these in Firebase Console → Project settings → General → "Your apps" → SDK setup.
# (Web API keys are public client identifiers, not secrets.)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Groq API key for AI bill scanning (console.groq.com/keys).
# NOTE: this is used client-side for the demo — proxy it through a backend
# in production so the key isn't exposed to browsers.
VITE_GROQ_API_KEY=
