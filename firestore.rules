rules_version = '2';

// DistributeIQ — each signed-in user owns exactly one store document tree
// at /stores/{uid} and everything beneath it. No cross-store access.
service cloud.firestore {
  match /databases/{database}/documents {
    match /stores/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;

      match /{sub=**} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
    }

    // Shared master product catalogue: any signed-in user may read it and
    // contribute new products (used for quick daily-sales logging).
    match /catalog/{itemId} {
      allow read, write: if request.auth != null;
    }
  }
}
